{
 "additionalProperties": false,
 "description": "Описание глобального адаптера. Подписывается ключом сервера (signing key), чей публичный ключ закреплён в клиенте.",
 "properties": {
  "version": {
   "minimum": 1,
   "title": "Version",
   "type": "integer"
  },
  "spec_id": {
   "title": "Spec Id",
   "type": "string"
  },
  "spec_hash": {
   "pattern": "^[0-9a-f]{64}$",
   "title": "Spec Hash",
   "type": "string"
  },
  "sha256": {
   "description": "SHA-256 файла адаптера (safetensors fp32)",
   "pattern": "^[0-9a-f]{64}$",
   "title": "Sha256",
   "type": "string"
  },
  "size_bytes": {
   "title": "Size Bytes",
   "type": "integer"
  },
  "created_at": {
   "description": "unix-время публикации",
   "title": "Created At",
   "type": "integer"
  },
  "round_clients": {
   "anyOf": [
    {
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "сколько обновлений вошло в версию",
   "title": "Round Clients"
  },
  "rollback_of": {
   "anyOf": [
    {
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "версия-содержимое, если это откат",
   "title": "Rollback Of"
  },
  "download_path": {
   "title": "Download Path",
   "type": "string"
  },
  "signature": {
   "maxLength": 88,
   "minLength": 88,
   "title": "Signature",
   "type": "string"
  }
 },
 "required": [
  "version",
  "spec_id",
  "spec_hash",
  "sha256",
  "size_bytes",
  "created_at",
  "download_path",
  "signature"
 ],
 "title": "ModelInfo",
 "type": "object"
}
