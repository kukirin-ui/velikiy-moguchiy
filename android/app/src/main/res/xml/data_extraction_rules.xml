<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted DashScope key is useless on another phone: back up nothing. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
